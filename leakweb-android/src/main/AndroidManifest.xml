<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The web server listens on a local socket. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="io.github.rogerphilippe.leakweb.internal.LeakWebAnalysisService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:process=":leakweb" />
        <!-- Automatic start with the default config. Remove this meta-data in the app manifest to call
             LeakWeb.start() manually (see the README). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.github.rogerphilippe.leakweb.LeakWebInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
